{
  "name": "gramota-site",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Marketing site + documentation for Gramota — the TypeScript SDK for the EU Digital Identity Wallet.",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "vite",
    "build": "pnpm gen:api && vite build",
    "gen:api": "node scripts/generate-api-docs.mjs",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "node dist/analog/server/index.mjs",
    "video": "node scripts/record-demo.mjs"
  },
  "dependencies": {
    "@analogjs/content": "^2.5.1-beta.2",
    "@analogjs/router": "^2.5.1-beta.2",
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "front-matter": "^4.0.2",
    "marked": "^15.0.7",
    "marked-gfm-heading-id": "^4.1.1",
    "marked-mangle": "^1.1.10",
    "marked-shiki": "^1.1.0",
    "rxjs": "~7.8.0",
    "shiki": "^1.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/platform": "^2.5.1-beta.2",
    "@analogjs/vite-plugin-angular": "^2.5.1-beta.2",
    "@analogjs/vitest-angular": "^2.5.1-beta.2",
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@gramota/credential-format": "^0.1.1",
    "@gramota/dcql": "^0.1.1",
    "@gramota/holder": "^0.1.1",
    "@gramota/issuer": "^0.3.0",
    "@gramota/jose": "^0.2.0",
    "@gramota/oid4vci": "^0.2.0",
    "@gramota/oid4vp": "^0.2.0",
    "@gramota/presentation-exchange": "^0.1.1",
    "@gramota/sd-jwt": "^0.2.0",
    "@gramota/status-list": "^0.1.1",
    "@gramota/trust": "^0.1.1",
    "@gramota/verifier": "^0.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "jsdom": "^22.0.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.0.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "vite": "$vite",
    "vitest": "$vitest"
  }
